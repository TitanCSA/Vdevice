<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FC" Margin="0">
  <Grid.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172C48"/><Setter Property="BorderBrush" Value="#D9E3F1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172C48"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Grid.Resources>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Vdevice" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Create and control virtual USB devices" FontSize="14" Margin="0,5,0,20" Foreground="#627590"/></StackPanel>
    <TextBlock Grid.Row="1" Text="Microsoft-signed driver · Windows 10/11 x64 · One-hour demo per Windows boot" Foreground="#627590" Margin="0,0,0,18"/>
    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,-12,18">
      <Border Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="INSTALLATION" Foreground="#627590" FontSize="11"/><TextBlock x:Name="InstallationState" Text="Checking…" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock x:Name="InstallationDetail" Text="Reading Windows device and package state" Foreground="#627590" FontSize="12"/></StackPanel></Border>
      <Border Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="KERNEL DRIVER" Foreground="#627590" FontSize="11"/><TextBlock x:Name="DriverState" Text="Checking…" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock x:Name="DriverDetail" Text="Reading service and active driver image" Foreground="#627590" FontSize="12"/></StackPanel></Border>
      <Border Background="White" BorderBrush="#DFE7F3" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="DRIVER API" Foreground="#627590" FontSize="11"/><TextBlock x:Name="ApiState" Text="Checking…" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock x:Name="ApiDetail" Text="Read-only check; no virtual device created" Foreground="#627590" FontSize="12"/></StackPanel></Border>
    </UniformGrid>
    <WrapPanel Grid.Row="3" Margin="0,0,0,18"><Button x:Name="Install" Content="Install / update" Background="#1765E9" Foreground="White" BorderBrush="#1765E9"/><Button x:Name="Uninstall" Content="Uninstall"/><Button x:Name="Diagnose" Content="Diagnose"/><Button x:Name="Refresh" Content="Refresh status"/></WrapPanel>
    <StackPanel Grid.Row="4" Margin="0,0,0,16"><Border Background="#E8EFFF" CornerRadius="10" Padding="14" Margin="0,0,0,12"><DockPanel><Button x:Name="RebootButton" DockPanel.Dock="Right" Content="Restart Windows" Visibility="Collapsed" Margin="14,0,0,0"/><TextBlock x:Name="Status" Text="Reading installation status…" VerticalAlignment="Center"/></DockPanel></Border><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Foreground="#1765E9" Background="#E0E8F5" BorderThickness="0"/></StackPanel>
    <Border Grid.Row="5" Background="#132944" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="DETAILED REPORT" Foreground="#8DB7FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/><TextBox x:Name="Log" Grid.Row="1" Background="Transparent" Foreground="#E8F0FF" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
    <DockPanel Grid.Row="6" Margin="0,16,0,0"><Button x:Name="Copy" Content="Copy report" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="Read-only diagnostics do not inject input. Restart is always your choice. Windows security settings are preserved." VerticalAlignment="Center" Foreground="#627590" FontSize="12"/></DockPanel>
  </Grid>
</Grid>
