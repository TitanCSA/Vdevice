<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" Background="#F4F7FC">
  <Grid.Resources>
    <x:Array x:Key="DescriptorKinds" Type="sys:String"><sys:String>Standard</sys:String><sys:String>Report</sys:String></x:Array>
    <x:Array x:Key="RuleActions" Type="sys:String"><sys:String>Reply</sys:String><sys:String>Accept</sys:String><sys:String>Stall</sys:String></x:Array>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172C48"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172C48"/><Setter Property="BorderBrush" Value="#D4E0F1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="BorderBrush" Value="#D4E0F1"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="BorderBrush" Value="#DFE7F3"/><Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F4F7FC"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="29"/></Style>
    <Style x:Key="BytePreview" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="FontFamily" Value="Consolas"/></Style>
  </Grid.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="Refresh" Content="Refresh status" DockPanel.Dock="Right" VerticalAlignment="Center" Height="36"/><StackPanel><TextBlock Text="Vdevice · Descriptor Workshop" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="One raw USB workflow: describe the interfaces, create the device, exchange exact bytes." Foreground="#627590" Margin="0,5,0,14"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#E7EFFD" CornerRadius="9" Padding="11" Margin="0,0,0,14"><TextBlock x:Name="Status" Text="Reading driver state…" FontSize="12"/></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="1 · CONFIGURE EXACT DESCRIPTORS" FontSize="12" FontWeight="Bold" Foreground="#1765E9"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Import" Content="Import JSON" Padding="9,5"/><Button x:Name="Export" Content="Export JSON" Padding="9,5"/></StackPanel></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Local label (does not rewrite USB strings)" FontSize="11"/><TextBox x:Name="DeviceName" Text="My USB device"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="USB speed" FontSize="11"/><ComboBox x:Name="Speed" SelectedIndex="1"><ComboBoxItem Content="Low · 1.5 Mbit/s"/><ComboBoxItem Content="Full · 12 Mbit/s"/><ComboBoxItem Content="High · 480 Mbit/s"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="IN depth" FontSize="11"/><TextBox x:Name="Depth" Text="32"/></StackPanel></Grid>
        <TabControl Grid.Row="2" BorderBrush="#DFE7F3" Margin="0,2,0,10">
          <TabItem Header="Descriptors"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="AddDescriptor" Content="Add descriptor" Padding="10,6"/><Button x:Name="RemoveDescriptor" Content="Remove selected" Padding="10,6"/></StackPanel>
            <DataGrid x:Name="Descriptors" Grid.Row="1"><DataGrid.Columns><DataGridComboBoxColumn Header="Kind" Width="90" SelectedItemBinding="{Binding Kind,UpdateSourceTrigger=PropertyChanged}" ItemsSource="{StaticResource DescriptorKinds}"/><DataGridTextColumn Header="Index" Width="48" Binding="{Binding Index,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Lang hex" Width="65" Binding="{Binding Language,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Interface" Width="65" Binding="{Binding Interface,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Exact bytes (hex)" Width="*" MinWidth="140" Binding="{Binding Bytes,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource BytePreview}"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="2" Text="Selected descriptor · exact bytes" FontSize="11" Margin="0,10,0,0"/>
            <TextBox Grid.Row="3" Text="{Binding SelectedItem.Bytes,ElementName=Descriptors,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="80"/>
            <TextBlock Grid.Row="4" Foreground="#627590" FontSize="11" Text="Standard: complete USB device/configuration/string bytes; type is byte 1. Report: raw HID report descriptor for the selected interface. Index and interface are decimal; language is hex. VID/PID and strings live inside your exact descriptor bytes."/>
          </Grid></TabItem>
          <TabItem Header="Control rules"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="AddRule" Content="Add rule" Padding="10,6"/><Button x:Name="RemoveRule" Content="Remove selected" Padding="10,6"/></StackPanel>
            <DataGrid x:Name="Rules" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Setup · 8 bytes" Width="*" Binding="{Binding Setup,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource BytePreview}"/><DataGridTextColumn Header="Mask · 8 bytes" Width="*" Binding="{Binding Mask,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource BytePreview}"/><DataGridComboBoxColumn Header="Action" Width="82" SelectedItemBinding="{Binding Action,UpdateSourceTrigger=PropertyChanged}" ItemsSource="{StaticResource RuleActions}"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="2" Text="Selected rule · reply bytes (empty for Accept / Stall)" FontSize="11" Margin="0,10,0,0"/>
            <TextBox Grid.Row="3" Text="{Binding SelectedItem.Bytes,ElementName=Rules,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="80"/>
            <StackPanel Grid.Row="4"><CheckBox x:Name="Delegate" Content="Delegate unmatched control requests to this application" Margin="0,8,0,8"/><TextBlock Foreground="#627590" FontSize="11" Text="Rules match masked setup bytes. Provide fixed replies here for requests that must finish quickly. Delegated requests appear on the right and expire after five seconds. Accept/Stall rules use empty reply data."/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="Field guide"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15"><TextBlock Text="No hidden descriptor rewriting" FontSize="18" FontWeight="SemiBold"/><TextBlock Margin="0,10,0,12" Text="This editor passes your descriptor and rule bytes unchanged through the same SDK calls for every interface. No device family is selected or inferred."/><TextBlock Text="Required structure" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,12" Text="Supply a standard device descriptor (18 bytes, type 01) and configuration descriptor (type 02) containing its interface and endpoint descriptors. Supply referenced strings as type 03 descriptors. HID interfaces additionally need their interface-specific Report entry."/><TextBlock Text="Lengths and little endian fields" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,12" Text="bLength is the descriptor's byte count. Configuration wTotalLength must equal the entire configuration byte array. The HID descriptor's report length must equal the raw report byte count. Multi-byte USB fields, including VID/PID, language IDs and lengths, are little endian."/><TextBlock Text="Selectors and endpoint addresses" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,12" Text="Use each descriptor's index, language and interface selectors exactly as Windows will request them. Language 0409 represents English (US); the string bytes themselves are UTF-16LE. IN endpoint addresses set bit 7 (for example 81); OUT addresses do not. Endpoint numbers, transfer type, maximum packet size and interval must agree with the selected speed and protocol."/><TextBlock Text="Create and communicate" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,12" Text="Validate offline, then create. Send exact IN bytes on the selected endpoint. Inspect complete OUT/control payloads and respond or stall pending controls. Windows chooses its matching client driver from your descriptors and driver packages; a VID/PID alone does not recreate another product's protocol."/><TextBlock Text="Lifetime" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,12" Text="Edit the configuration for the next creation; existing devices are not silently changed. Delete owned devices explicitly or close the application to dispose them. Raw protocols have no universal neutral/reset report: send the correct release bytes for your protocol when needed."/></StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal"><Button x:Name="Validate" Content="Validate offline"/><Button x:Name="Create" Content="Create device" Background="#1765E9" Foreground="White"/></StackPanel><TextBlock Text="Exact bytes, no automatic repair. Validation does not certify proprietary protocol compatibility." Foreground="#99651B" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      </Grid></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="65"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="2 · OWNED DEVICES &amp; RAW TRANSFERS" FontSize="12" FontWeight="Bold" Foreground="#1765E9"/><Button x:Name="Delete" Content="Delete selected" DockPanel.Dock="Right" Padding="10,6" HorizontalAlignment="Right"/></DockPanel>
        <ListBox x:Name="Devices" Grid.Row="1" BorderBrush="#DFE7F3" Margin="0,4,0,8"/>
        <TextBlock x:Name="Details" Grid.Row="2" Foreground="#627590" FontSize="11" Margin="0,0,0,10"/>
        <TabControl Grid.Row="3" BorderBrush="#DFE7F3">
          <TabItem Header="Send IN"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="USB IN endpoint address (hex)"/><TextBox x:Name="Endpoint" Text="81"/><TextBlock Text="Exact report/transfer bytes (hex separated by spaces)"/><TextBox x:Name="InputBytes" AcceptsReturn="True" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/><Button x:Name="Send" Content="Send exact bytes" HorizontalAlignment="Left"/><TextBlock Text="The selected device receives these bytes unchanged. Matching framing, report IDs, release states and protocol behavior are your responsibility. Empty transfers are passed through only when the endpoint supports them." Foreground="#99651B" FontSize="11" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="OUT / controls"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="Outputs" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Time" Width="86" Binding="{Binding Time}"/><DataGridTextColumn Header="Device" Width="55" Binding="{Binding Device}"/><DataGridTextColumn Header="Kind" Width="*" Binding="{Binding Kind}"/><DataGridTextColumn Header="EP" Width="35" Binding="{Binding Endpoint}"/><DataGridTextColumn Header="Bytes" Width="48" Binding="{Binding Length}"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="1" Text="Selected packet · full setup and data (up to 4096 bytes)" FontSize="11" Margin="0,10,0,0"/>
            <TextBox x:Name="PacketBytes" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" MinHeight="80"/>
            <Button x:Name="CopyPacket" Grid.Row="3" Content="Copy complete packet" HorizontalAlignment="Left" Padding="10,6"/>
          </Grid></TabItem>
          <TabItem Header="Reply"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Pending delegated control requests" FontWeight="SemiBold"/>
            <ListBox x:Name="Pending" Grid.Row="1" BorderBrush="#DFE7F3" Margin="0,6,0,10" FontFamily="Consolas" FontSize="11"/>
            <TextBlock x:Name="Deadline" Grid.Row="2" Text="The driver deadline is five seconds. Use control rules for prompt replies." Foreground="#99651B" FontSize="11" Margin="0,0,0,8"/>
            <TextBox x:Name="ResponseBytes" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" MinHeight="70"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal"><Button x:Name="Reply" Content="Reply with these bytes" Padding="10,6"/><Button x:Name="Stall" Content="Stall request" Padding="10,6"/></StackPanel>
          </Grid></TabItem>
        </TabControl>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="3" Margin="0,14,0,0" Background="#132944" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="Copy" Content="Copy log" DockPanel.Dock="Right" Padding="10,4" Margin="0,0,0,7"/><TextBlock Text="OPERATIONS · Full packet bytes are available in OUT / controls" Foreground="#8DB7FF" FontWeight="Bold" FontSize="11"/></DockPanel><TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" Background="Transparent" Foreground="#E8F0FF" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" Padding="0"/></Grid></Border>
  </Grid>
</Grid>
